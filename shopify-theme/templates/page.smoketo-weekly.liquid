.sb-meal-body { padding: 11px 12px 13px; }
.sb-meal-name { font-weight: 700; font-size: .83rem; color: #1c1c1c; line-height: 1.3; margin-bottom: 4px; }
.sb-meal-desc { font-size: .71rem; color: #888; line-height: 1.5; margin-bottom: 10px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.sb-macros { display: flex; gap: 0; background: #f7f5f2; border-radius: 10px; padding: 8px 6px; margin-bottom: 10px; border: 1px solid #e8e8e8; }
.sb-macro { flex: 1; text-align: center; position: relative; }
.sb-macro + .sb-macro::before { content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 1px; height: 60%; background: #e8e8e8; }
.sb-macro-v { display: block; font-weight: 800; font-size: .78rem; color: #1c1c1c; }
.sb-macro-l { display: block; font-size: .5rem; color: #aaa; text-transform: uppercase; letter-spacing: .05em; margin-top: 1px; }
.sb-variant-wrap { margin-bottom: 10px; }
.sb-variant-select { width: 100%; padding: 7px 10px; border: 1.5px solid #e8e8e8; border-radius: 8px; font-family: 'DM Sans', sans-serif; font-size: .74rem; color: #1c1c1c; background: #fff; cursor: pointer; outline: none; }
.sb-variant-select:focus { border-color: #b85c2a; }
.sb-meal-footer { display: flex; align-items: center; justify-content: flex-end; gap: 8px; }
.sb-add-btn { padding: 6px 14px; border-radius: 50px; border: none; background: #1c1c1c; color: #fff; font-family: 'DM Sans', sans-serif; font-size: .74rem; font-weight: 700; cursor: pointer; transition: all .2s; white-space: nowrap; width: 100%; }
.sb-add-btn:hover { background: #b85c2a; }
.sb-add-btn:disabled { background: #e8e8e8; color: #bbb; cursor: not-allowed; }
.sb-qty-ctrl { display: none; align-items: center; justify-content: center; gap: 6px; width: 100%; }
.sb-meal-card.selected .sb-qty-ctrl { display: flex; }
.sb-meal-card.selected .sb-add-btn { display: none; }
.sb-qty-btn { width: 26px; height: 26px; border-radius: 50%; border: 1.5px solid #e8e8e8; background: #fff; font-size: .9rem; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all .18s; font-family: 'DM Sans', sans-serif; }
.sb-qty-btn:hover { background: #b85c2a; color: #fff; border-color: #b85c2a; }
.sb-qty-num { font-weight: 800; font-size: .85rem; min-width: 18px; text-align: center; }
.sb-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

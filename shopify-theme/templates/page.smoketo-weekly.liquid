@keyframes sbmSlide { from { transform: translateY(24px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
.sbm-close { position: absolute; top: 14px; right: 15px; width: 34px; height: 34px; border-radius: 50%; background: rgba(255,255,255,.92); border: none; color: #3d3d3d; font-size: 1rem; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 3px 12px rgba(0,0,0,.18); z-index: 4; transition: background .2s; }
.sbm-close:hover { background: #fff; }
.sbm-nav { position: absolute; top: 130px; width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,.92); border: none; color: #b85c2a; font-size: 1.5rem; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 14px rgba(0,0,0,.2); z-index: 4; transition: transform .18s, background .18s; }
.sbm-nav:hover { transform: scale(1.08); background: #fff; }
.sbm-prev { left: 12px; }
.sbm-next { right: 12px; }
.sbm-img { width: 100%; height: 280px; overflow: hidden; position: relative; border-radius: 24px 24px 0 0; background: linear-gradient(135deg,#fff8f4,#f5ebe3); }
.sbm-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.sbm-img-fallback { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 4.5rem; }
.sbm-badge-bar { position: absolute; bottom: 0; left: 0; right: 0; padding: 13px 20px; background: linear-gradient(to top, rgba(0,0,0,.7), transparent); display: flex; gap: 7px; }
.sbm-badge { padding: 4px 11px; border-radius: 20px; font-size: .62rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: #fff; background: #b85c2a; }
.sbm-body { padding: 22px 24px 26px; }
.sbm-name { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 900; margin-bottom: 9px; color: #1c1c1c; }
.sbm-desc { color: #6b6b6b; font-size: .88rem; line-height: 1.7; margin-bottom: 18px; white-space: pre-line; }
.sbm-macros { display: grid; grid-template-columns: repeat(4,1fr); gap: 8px; padding: 13px; background: #f7f5f2; border-radius: 13px; border: 1px solid #e8e8e8; margin-bottom: 18px; }
.sbm-mg { text-align: center; }
.sbm-mg-v { display: block; font-family: 'Playfair Display', serif; font-size: 1.25rem; font-weight: 700; color: #b85c2a; }
.sbm-mg-l { display: block; font-size: .56rem; color: #6b6b6b; letter-spacing: .07em; text-transform: uppercase; margin-top: 2px; }
.sbm-var { margin-bottom: 16px; }
.sbm-var-label { display: block; font-size: .66rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #6b6b6b; margin-bottom: 8px; }
.sbm-var select { width: 100%; border: 1.5px solid #d0d0d0; border-radius: 10px; padding: 10px 12px; font-size: .85rem; background: #fff; font-family: 'DM Sans', sans-serif; cursor: pointer; }
.sbm-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 20px; }

.sb-progress-labels { display: flex; justify-content: space-between; padding: 0 2px; }
.sb-prog-label { font-size: .62rem; color: #bbb; text-align: center; width: 28px; transition: color .3s; }
.sb-prog-label.active { color: #b85c2a; font-weight: 600; }
.sb-prog-label.done { color: #888; }
.sb-step { display: none; max-width: 860px; margin: 0 auto; padding: 40px 5%; }
.sb-step.active { display: block; }
.sb-step-heading { font-family: 'Playfair Display', serif; font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 900; margin-bottom: 6px; line-height: 1.2; }

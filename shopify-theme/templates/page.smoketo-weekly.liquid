.sb-prog-dot.done { background: #b85c2a; border-color: #b85c2a; color: #fff; }
.sb-prog-dot.active { border-color: #b85c2a; color: #b85c2a; box-shadow: 0 0 0 3px rgba(184,92,42,.15); }
.sb-prog-line { flex: 1; height: 2px; background: #e8e8e8; transition: background .3s; }

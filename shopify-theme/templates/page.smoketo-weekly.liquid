/* ── MEAL DETAIL POP-OUT ── */
.sb-meal-img, .sb-meal-name { cursor: pointer; }
.sb-view-btn { position: absolute; top: 10px; right: 10px; width: 34px; height: 34px; border-radius: 50%; border: none; background: rgba(255,255,255,.92); color: #b85c2a; font-size: .95rem; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 3px 10px rgba(0,0,0,.14); transition: transform .18s, background .18s; z-index: 2; }
.sb-view-btn:hover { transform: scale(1.08); background: #fff; }
.sbm-back { position: fixed; inset: 0; background: rgba(10,10,10,.74); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); z-index: 9500; display: none; align-items: center; justify-content: center; padding: 16px; }

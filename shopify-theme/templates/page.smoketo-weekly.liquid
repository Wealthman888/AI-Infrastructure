.sb-nav-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 8px; }
.sb-btn-back { padding: 12px 24px; border-radius: 50px; border: 1.5px solid #e8e8e8; background: #fff; color: #555; font-family: 'DM Sans', sans-serif; font-size: .88rem; font-weight: 600; cursor: pointer; transition: all .2s; }

.sb-review-meal-qty { color: #888; font-size: .78rem; }
.sb-start-btn { display: block; width: 100%; padding: 16px 24px; background: #b85c2a; color: #fff; border: none; border-radius: 50px; font-family: 'DM Sans', sans-serif; font-size: 1rem; font-weight: 800; cursor: pointer; text-align: center; transition: all .25s; margin-bottom: 12px; }

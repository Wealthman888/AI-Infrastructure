.sb-btn-next { padding: 13px 32px; border-radius: 50px; border: none; background: #1c1c1c; color: #fff; font-family: 'DM Sans', sans-serif; font-size: .9rem; font-weight: 700; cursor: pointer; transition: all .22s; margin-left: auto; }
.sb-btn-next:hover { background: #b85c2a; transform: translateY(-1px); }

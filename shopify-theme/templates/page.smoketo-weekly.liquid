.sb-review-label { font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: #aaa; margin-bottom: 10px; }
.sb-review-meal-row { display: flex; align-items: center; gap: 12px; padding: 6px 0; border-bottom: 1px solid #f7f5f2; font-size: .83rem; }

@media (max-width: 480px) { .sb-plan-grid { grid-template-columns: 1fr 1fr; gap: 10px; } }
.sb-plan-card { background: #fff; border: 2px solid #e8e8e8; border-radius: 18px; padding: 22px 16px 18px; cursor: pointer; transition: all .22s; position: relative; text-align: center; user-select: none; }
.sb-plan-card:hover { border-color: #ccc; transform: translateY(-2px); }
.sb-plan-card.sel { border-color: #b85c2a; background: #fdf1ea; box-shadow: 0 0 0 3px rgba(184,92,42,.12); }
.sb-plan-badge { position: absolute; top: -11px; left: 50%; transform: translateX(-50%); background: #b85c2a; color: #fff; font-size: .58rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; padding: 3px 10px; border-radius: 20px; white-space: nowrap; }
.sb-plan-badge.alt { background: #1c1c1c; }
.sb-plan-meals { font-family: 'Playfair Display', serif; font-size: 2.4rem; font-weight: 900; color: #b85c2a; line-height: 1; margin-bottom: 2px; }
.sb-plan-freq { font-size: .7rem; color: #888; margin-bottom: 6px; }
.sb-plan-price { font-size: .95rem; font-weight: 700; color: #b85c2a; margin-bottom: 2px; }
.sb-plan-per { font-size: .68rem; color: #888; }
.sb-plan-check { position: absolute; top: 10px; right: 10px; width: 20px; height: 20px; border-radius: 50%; background: #b85c2a; color: #fff; font-size: .65rem; display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity .2s; }
.sb-plan-card.sel .sb-plan-check { opacity: 1; }
.sb-chip-grid { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 32px; }
.sb-chip { padding: 10px 18px; border-radius: 50px; border: 1.5px solid #e8e8e8; background: #fff; font-family: 'DM Sans', sans-serif; font-size: .82rem; font-weight: 500; color: #555; cursor: pointer; transition: all .18s; user-select: none; }
.sb-chip:hover { border-color: #b85c2a; color: #b85c2a; }
.sb-chip.sel { border-color: #b85c2a; background: #b85c2a; color: #fff; font-weight: 700; }
.sb-meal-counter { background: #fff; border: 1px solid #e8e8e8; border-radius: 14px; padding: 14px 18px; display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 24px; flex-wrap: wrap; }
.sb-counter-text { font-size: .88rem; color: #666; }
.sb-counter-text strong { color: #1c1c1c; font-size: 1rem; }
.sb-counter-bar-wrap { flex: 1; min-width: 120px; height: 6px; background: #f0f0f0; border-radius: 50px; overflow: hidden; }
.sb-counter-bar { height: 100%; background: #b85c2a; border-radius: 50px; transition: width .3s ease; }
.sb-counter-limit { font-size: .72rem; color: #c0392b; font-weight: 600; display: none; }
.sb-counter-limit.show { display: block; }
.sb-meal-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 28px; }
@media (max-width: 760px) { .sb-meal-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } }
@media (max-width: 420px) { .sb-meal-grid { grid-template-columns: 1fr 1fr; gap: 10px; } }
.sb-meal-card { background: #fff; border: 1.5px solid #e8e8e8; border-radius: 14px; overflow: hidden; transition: all .22s; position: relative; }
.sb-meal-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,.08); transform: translateY(-2px); }
.sb-meal-card.selected { border-color: #b85c2a; }
.sb-meal-img { width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block; background: #f0ece8; }
.sb-meal-img-fallback { width: 100%; aspect-ratio: 4/3; background: linear-gradient(135deg, #fff8f4, #f5ebe3); display: flex; align-items: center; justify-content: center; font-size: 2.4rem; }
.sb-meal-badge-bar { position: absolute; top: 8px; left: 8px; }
.sb-meal-tag { display: inline-block; padding: 3px 8px; border-radius: 20px; font-size: .55rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }
.sb-t-keto { background: #eaf4ed; color: #2d6a3f; }
.sb-t-breakfast { background: #e8f0fb; color: #2c5fad; }
.sb-t-seafood { background: #faf0e8; color: #c0692a; }
.sb-t-bowl { background: #f3f0fb; color: #6741d9; }

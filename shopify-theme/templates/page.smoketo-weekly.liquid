.sb-upsell-thumb { width: 44px; height: 44px; border-radius: 9px; object-fit: cover; flex-shrink: 0; background: #f0ece8; }
.sb-upsell-thumb-fallback { width: 44px; height: 44px; border-radius: 9px; background: linear-gradient(135deg, #fff8f4, #f5ebe3); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; }
.sb-upsell-info { flex: 1 1 150px; min-width: 150px; }
.sb-upsell-name { font-weight: 600; font-size: .88rem; }
.sb-upsell-desc { font-size: .72rem; color: #888; margin-top: 2px; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.sb-upsell-badge { display: inline-block; font-size: .6rem; font-weight: 700; padding: 2px 7px; border-radius: 50px; margin-left: 6px; background: #f0f9f0; color: #2d6a2d; }

// ── BOX TALLY (shared with collection + product pages via localStorage) ──
function skPlanSize(){try{const p=JSON.parse(localStorage.getItem('sk_plan')||'null');return (p&&p.meals)?p.meals:8;}catch(e){return 8;}}
function skGetBox(){try{return JSON.parse(localStorage.getItem('sk_box')||'{}');}catch(e){return {};}}
function skSaveBox(b){try{localStorage.setItem('sk_box',JSON.stringify(b));}catch(e){}}
function skBoxQty(b){return Object.values(b).reduce((s,v)=>s+v.qty,0);}
function skRenderTally(){
  const box=skGetBox(),qty=skBoxQty(box),size=skPlanSize(),remaining=Math.max(0,size-qty);
  const el=document.getElementById('sk-tally');
  if(!el)return;
  el.style.display='flex';
  el.classList.toggle('full',qty>=size);
  const label=remaining>0?`${remaining} meal${remaining!==1?'s':''} remaining`:'✓ Review & Checkout';
  el.innerHTML=`<div class="skt-text"><span class="skt-label">${label}</span><span class="skt-sub">${qty} / ${size} selected</span></div><div class="skt-bar"><div class="skt-fill" style="width:${Math.min(100,Math.round(qty/size*100))}%"></div></div>`;
}
function skAddToBox(variantId,title,qty){
  qty=qty||1;
  const box=skGetBox(),size=skPlanSize(),cur=skBoxQty(box);
  if(cur>=size){showToast('📦 Box is full',`${size} meals selected — finish your order or upgrade your plan.`);return false;}
  const remaining=size-cur;
  if(qty>remaining)qty=remaining;
  const key=String(variantId);
  if(box[key])box[key].qty+=qty;else box[key]={title,qty};
  skSaveBox(box);
  skRenderTally();
  return true;
}
function skSyncBoxWithRealCart(){
  fetch('/cart.js').then(r=>r.json()).then(cart=>{
    if(cart.item_count===0){try{localStorage.removeItem('sk_box');}catch(e){}}
    skRenderTally();
  }).catch(()=>skRenderTally());
}
skSyncBoxWithRealCart();
// Initialize cart from sk_box on load so dot/bar reflect cross-page selections
document.addEventListener('DOMContentLoaded',function(){skInitCartFromBox();updateCartUI();});
// Re-sync when restored from bfcache (e.g. hitting Back from Shopify checkout) —
// otherwise the cart modal/tally can show stale state from before checkout ran.
window.addEventListener('pageshow',function(e){
  if(e.persisted){
    skSyncBoxWithRealCart();
    skInitCartFromBox();
    updateCartUI();
    skRenderTally();
  }
});

// ── CART STATE ──
let CART=[];

// Build CART from sk_box localStorage so selections from any page show here
function skInitCartFromBox(){
  const box=skGetBox();
  CART=[];
  Object.entries(box).forEach(([vid,entry])=>{
    const meal=PRODUCTS.find(m=>m.vars.some(v=>String(v.id)===String(vid)));
    if(!meal)return;
    const variant=meal.vars.find(v=>String(v.id)===String(vid))||meal.vars[0];
    const key=meal.id+'-'+variant.id;
    const ex=CART.find(c=>c.key===key);
    if(ex)ex.qty+=entry.qty;
    else CART.push({key,meal,variant,qty:entry.qty});
  });
}

function addToCart(meal,variant,qty){
  if(!skAddToBox(variant.id,meal.name,qty))return;
  const key=meal.id+'-'+variant.id;
  const ex=CART.find(c=>c.key===key);
  if(ex)ex.qty+=qty;
  else CART.push({key,meal,variant,qty});
  updateCartUI();
  showToast('🥩 Added to Box',meal.name+(variant.t!=='Default Title'?' ('+variant.t+')':''));
}
function removeItem(key){
  const it=CART.find(c=>c.key===key);
  if(it){
    // remove from sk_box
    const box=skGetBox();
    delete box[String(it.variant.id)];
    skSaveBox(box);
    skRenderTally();
  }
  CART=CART.filter(c=>c.key!==key);
  updateCartUI();
}
function chgCartQty(key,d){
  const it=CART.find(c=>c.key===key);
  if(it){
    const newQty=Math.max(1,it.qty+d);
    // cap at plan size
    if(d>0){const box=skGetBox(),size=skPlanSize(),cur=skBoxQty(box);if(cur>=size){showToast('📦 Box is full',`${size} meals selected`);return;}}
    it.qty=newQty;
    // sync sk_box
    const box=skGetBox();
    const vid=String(it.variant.id);
    if(box[vid])box[vid].qty=newQty;
    skSaveBox(box);
    skRenderTally();
  }
  updateCartUI();
}
function updateCartUI(){
  const count=CART.reduce((s,c)=>s+c.qty,0);
  const planSize=skPlanSize();
  // bar
  document.getElementById('cb-count').textContent=count>0?`${count} of ${planSize} meals selected`:'Your cart is empty';
  document.getElementById('cb-total').textContent=count>0?`${count} / ${planSize} meals in your box`:'Add meals to start your order';
  document.getElementById('cart-bar').classList.toggle('on',count>0);
  // dot
  const dot=document.getElementById('cart-dot');
  dot.textContent=count;dot.classList.toggle('on',count>0);
  // subtotal (show meal count instead of $0 price)
  const sv=document.getElementById('cart-sub-val');
  if(sv)sv.textContent=`${count} meal${count!==1?'s':''}`;
  // free-delivery progress ($149 threshold, excludes the fee's own line) —
  // uses the real box price + real variant upcharges (sp), never the
  // marketing display price (p), so this matches what checkout actually charges.
  const cbPlan=SUB_PLANS.find(p=>p.meals===planSize)||SUB_PLANS[1];
  const cartSubtotal=(count>0?cbPlan.weekly:0)+CART.reduce((s,c)=>s+((c.variant.sp||0)*c.qty),0);
  const feeApplies=cartSubtotal<149;
  const fsFill=document.getElementById('cart-freeship-fill');
  const fsMsg=document.getElementById('cart-freeship-msg');
  if(fsFill){
    const pct=Math.min(100,Math.round((cartSubtotal/149)*100));
    fsFill.style.width=pct+'%';
    fsFill.classList.toggle('complete',!feeApplies);
  }
  if(fsMsg){
    fsMsg.textContent=(count===0)
      ? '🚚 Free delivery on orders over $149 · Powered by Shopify'
      : (feeApplies
        ? `🚚 Add $${(149-cartSubtotal).toFixed(2)} more for free delivery`
        : "🎉 You've unlocked free delivery!");
  }
  // body
  const body=document.getElementById('cart-body');
  if(!body)return;
  if(CART.length===0){
    body.innerHTML='<div class="cart-empty"><div class="ce-icon">🛒</div><p>Your cart is empty.<br>Browse the menu and add some meals!</p></div>';
  }else{
    body.innerHTML=CART.map(c=>`
      <div class="cart-row">
        <div class="cart-thumb">${c.meal.img?`<img src="${c.meal.img}" onerror="this.style.display='none'"/>`:'🥩'}</div>
        <div class="cart-info">
          <div class="cart-name">${c.meal.name}</div>
          ${c.variant.t!=='Default Title'?`<div class="cart-var">${c.variant.t}</div>`:''}
          <div class="cart-qty">
            <button class="cq" onclick="chgCartQty('${c.key}',-1)">−</button>
            <span style="font-weight:700;font-size:.82rem;min-width:18px;text-align:center">${c.qty}</span>
            <button class="cq" onclick="chgCartQty('${c.key}',1)">+</button>
          </div>
        </div>
        <div class="cart-right">
          <button class="cart-rm" onclick="removeItem('${c.key}')">Remove</button>
        </div>
      </div>
    `).join('');
  }
}
function openCartModal(){skInitCartFromBox();updateCartUI();openM('cart-modal');}
function closeCart(e,f){if(f)closeM('cart-modal');else bdClose(e,'cart-modal');}
const SK_SELLING_PLAN_ID = 692247331121;
// Build checkout query params (guest email prefill from Step 1 capture) so
// email is never asked twice — Shopify's hosted checkout accepts checkout[email].
// The first-order discount is automatic (built into the selling plan's own
// pricing), so no discount code needs to be passed here.
function buildCheckoutParams(){
  const params=new URLSearchParams();
  try{const em=sessionStorage.getItem('sk_session_email');if(em)params.set('checkout[email]',em);}catch(e){}
  const qs=params.toString();
  return qs?`?${qs}`:'';
}

function goCheckout(){
  skInitCartFromBox();// ensure CART matches sk_box before checkout
  if(CART.length===0){showToast('🛒 Cart Empty','Add some meals first!');return;}
  const planSize=skPlanSize();
  const plan=SUB_PLANS.find(p=>p.meals===planSize)||SUB_PLANS[1];
  if(!plan.box){showToast('⚠️ Checkout Error',"This box size isn't available yet — please contact support.");return;}
  showToast('🔒 Secure Checkout','Sending your box to Shopify checkout...');

  // The box itself is one priced line item (selected meals ride along as
  // properties); individual box-meal variants are $0 in Shopify by design,
  // so they must never be added as their own priced line — only real
  // upgrade variants (sp > 0, e.g. "Double Protein") get their own line.
  const mealProps={};
  let mc=1;
  CART.forEach(c=>{
    const title=c.meal.name+(c.variant.t!=='Default Title'?` (${c.variant.t})`:'');
    mealProps['Meal '+mc++]=title+(c.qty>1?` x${c.qty}`:'');
  });
  const boxItem={id:plan.box,quantity:1,selling_plan:SK_SELLING_PLAN_ID,properties:mealProps};
  const extraItems=[];
  let variantUpcharge=0;
  CART.forEach(c=>{
    if(c.variant.sp){
      variantUpcharge+=c.variant.sp*c.qty;
      extraItems.push({id:c.variant.id,quantity:c.qty,selling_plan:SK_SELLING_PLAN_ID,properties:{Meal:c.meal.name+' ('+c.variant.t+')'}});
    }else{
      // $0 box-meal variant — added as its own zero-priced line (in addition to
      // the human-readable summary in the box's own properties above) so the
      // order exposes real, SKU'd line items for kitchen prep reporting.
      extraItems.push({id:c.variant.id,quantity:c.qty,selling_plan:SK_SELLING_PLAN_ID,properties:{Box:plan.label+' Box'}});
    }
  });
  // Free-delivery threshold ($149) — box price plus any priced variant upcharges.
  const checkoutSubtotal=plan.weekly+variantUpcharge;
  if(checkoutSubtotal<149)extraItems.push({id:SK_DELIVERY_FEE_VARIANT,quantity:1});
  // Clear the real cart first so a repeat checkout (e.g. back-button then retry)
  // never doubles up items or stale delivery-fee lines.
  fetch(`https://${DOMAIN}/cart/clear.js`,{method:'POST'})
    .then(r=>{ if(!r.ok) throw new Error('Could not reset your cart. Please try again.'); return r; })
    .then(()=>fetch(`https://${DOMAIN}/cart/add.js`,{
      method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({items:[boxItem]})
    }))
    .then(r=>r.json().then(data=>{
      // The box item is the whole order — unlike the extras below, its
      // failure must stop checkout instead of silently redirecting to an
      // empty/wrong cart (this was the root cause of "can't checkout").
      if(!r.ok) throw new Error((data&&(data.description||data.message))||'Your box could not be added to checkout.');
      return data;
    }))
    .then(()=>
      // Add each priced upcharge/delivery-fee line as its own request.
      // Shopify's /cart/add.js is all-or-nothing for a batched items array —
      // a single rejected line must never silently drop every other add-on.
      extraItems.reduce((chain,item)=>chain.then(()=>
        fetch(`https://${DOMAIN}/cart/add.js`,{
          method:'POST',headers:{'Content-Type':'application/json'},
          body:JSON.stringify({items:[item]})
        }).then(r=>{ if(!r.ok) return r.json().then(e=>console.error('SmoKeto add-on failed:',item,e)); })
      ).catch(e=>console.error('SmoKeto add-on network error:',item,e)),Promise.resolve())
    )
    .then(()=>{
      window.location.href=`https://${DOMAIN}/checkout${buildCheckoutParams()}`;
    }).catch(err=>{
      console.error('SmoKeto checkout error:',err);
      showToast('⚠️ Checkout Error',(err&&err.message)||'Please try again.');
    });
}


// ── NUKE HOPPY POPUPS BAR ──
(function killHoppyBar(){
  function removeBar(){
    // Target by known Hoppy selectors + any dark top bar injected before our nav
    var selectors=[
      '[id*="hoppy"]','[class*="hoppy"]',
      '[id*="email-bar"]','[class*="email-bar"]',
      '[id*="email_bar"]','[class*="email_bar"]',
      '[id*="collection-bar"]','[class*="collection-bar"]',
      'iframe[src*="hoppy"]'
    ];
    selectors.forEach(function(sel){
      document.querySelectorAll(sel).forEach(function(el){
        el.style.cssText='display:none!important;height:0!important;overflow:hidden!important;';
      });
    });
    // Also kill any fixed/sticky element sitting above our nav (z-index > 300 and top:0)
    document.querySelectorAll('body > *:not(#sk-root):not(script):not(style)').forEach(function(el){
      var st=window.getComputedStyle(el);
      var bg=st.backgroundColor;
      var pos=st.position;
      var top=st.top;
      // Dark background bar at top of page
      if((pos==='fixed'||pos==='sticky')&&top==='0px'&&(bg.includes('0, 0, 0')||bg.includes('17, 17')||bg.includes('rgb(0')||bg==='rgb(0, 0, 0)')){
        el.style.cssText='display:none!important;height:0!important;';
      }
    });
  }
  // Run immediately, after DOM ready, and watch for late injections
  removeBar();
  document.addEventListener('DOMContentLoaded',removeBar);
  var obs=new MutationObserver(removeBar);
  obs.observe(document.body||document.documentElement,{childList:true,subtree:false});
  // Stop watching after 5s
  setTimeout(function(){obs.disconnect();},5000);
})();

</script>



 

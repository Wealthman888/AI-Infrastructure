          ?`<img src="${m.img}" alt="${m.name}" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"/><div class="mc-img-fallback" style="display:none">🥩</div>`
          :`<div class="mc-img-fallback">🥩</div>`}

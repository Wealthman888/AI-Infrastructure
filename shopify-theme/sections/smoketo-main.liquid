let CUR=null,OV_QTY=1,OV_VAR=0;
const BG={keto:'#e8f4ec',breakfast:'#e8f0fb',seafood:'#faf0e8',popular:'#1c1c1c',new:'#f5ebe3'};
const FG={keto:'#2d6a3f',breakfast:'#2c5fad',seafood:'#c0692a',popular:'#fff',new:'#b85c2a'};

function openMeal(id){

<!-- ══ RENEWAL REMINDER BANNER ══ -->
<div id="sk-renewal-banner" style="display:none;background:#1c1c1c;color:#fff;padding:14px 20px;text-align:center;position:relative;z-index:200;margin-top:64px;">
  <span id="sk-renewal-msg" style="font-family:'DM Sans',sans-serif;font-size:.88rem;margin-right:14px;"></span>
  <a href="/pages/weekly" style="display:inline-block;background:#b85c2a;color:#fff;font-family:'DM Sans',sans-serif;font-size:.82rem;font-weight:700;padding:7px 18px;border-radius:50px;text-decoration:none;white-space:nowrap;">Pick This Week's Meals →</a>
  <button onclick="document.getElementById('sk-renewal-banner').style.display='none';try{localStorage.setItem('sk_banner_dismissed',Date.now());}catch(e){};" style="position:absolute;right:14px;top:50%;transform:translateY(-50%);background:none;border:none;color:rgba(255,255,255,.5);font-size:1.1rem;cursor:pointer;line-height:1;">✕</button>
</div>
<script>
(function(){
  try {
    var plan = JSON.parse(localStorage.getItem('sk_plan') || 'null');
    if (!plan || !plan.meals) return; // not a subscriber
    var dismissed = parseInt(localStorage.getItem('sk_banner_dismissed') || '0');
    var now = Date.now();
    if (dismissed && (now - dismissed) < 86400000) return; // dismissed within last 24h
    var day = new Date().getDay(); // 0=Sun,1=Mon...6=Sat
    // Show Thursday (4), Friday (5), Saturday (6) — renewal is every Sunday
    if (day < 4 && day !== 0) return;
    var msg = day === 0
      ? '🔥 Your box renews TODAY — make sure your meals are selected!'
      : (day >= 4 ? '🥩 Your weekly box renews Sunday — ' + (7 - day) + ' day' + (7 - day > 1 ? 's' : '') + ' left to choose your meals.' : '');
    if (!msg) return;
    document.getElementById('sk-renewal-msg').textContent = msg;
    document.getElementById('sk-renewal-banner').style.display = 'block';
  } catch(e) {}
})();
</script>


      <div class="rev-stars">${'★'.repeat(r.s)}</div>
      <p class="rev-text">"${r.txt}"</p>
      <div class="rev-author"><div class="rev-av">${r.av}</div><div><div class="rev-name">${r.name}</div><div class="rev-loc">📍 ${r.loc}</div></div></div>
    </div>
  `).join('');
}

// ── SURVEY ──
function openSurvey(){svStep(1);openM('survey-modal');}
function closeSurvey(e,f){if(f)closeM('survey-modal');else bdClose(e,'survey-modal');}
function svStep(n){
  document.querySelectorAll('.survey-step').forEach(s=>s.classList.remove('on'));
  document.getElementById('sv'+n).classList.add('on');
  if(n<=3){const p=document.getElementById('sv-prog');p.innerHTML='';for(let i=1;i<=3;i++){const d=document.createElement('div');d.className='sp-dot'+(i<=n?' done':'');p.appendChild(d);}}
  else document.getElementById('sv-prog').innerHTML='';
}
function finishSv(){
  svStep(4);
  try{
    // Save dietary preferences from quiz steps sv2 + sv3
    var goals=[];
    document.querySelectorAll('#sv1 .chip.sel').forEach(function(c){goals.push(c.textContent.trim());});
    var dietary=[];
    document.querySelectorAll('#sv2 .chip.sel').forEach(function(c){dietary.push(c.textContent.trim());});
    var allergens=[];
    document.querySelectorAll('#sv3 .chip.sel').forEach(function(c){allergens.push(c.textContent.trim());});
    var prefs=dietary.concat(allergens);
    if(prefs.length)localStorage.setItem('sk_dietary',JSON.stringify(prefs));
    // Save selected plan so /pages/weekly picks it up
    localStorage.setItem('sk_plan',JSON.stringify({meals:SUB_PLANS[selPlan].meals}));
    // Push quiz answers to cart attributes (guest + signed-in), and — for
    // signed-in customers only — queue them for the smoketo customer metafields.
    pushQuizToCart(dietary,allergens,goals);
    // Update quiz result with actual selected plan
    var resEl=document.getElementById('sv4-plan-summary');
    if(resEl){var p=SUB_PLANS[selPlan];resEl.innerHTML='<strong style="color:var(--ember)">'+p.meals+' meals/week · Keto · High Protein · Southern Nevada Delivery</strong>';}
  }catch(e){}
  // Auto-redirect to meal selection after showing the plan result
  setTimeout(function(){window.location.href='/pages/weekly';},2800);
}
// Cart attributes are safe to write from theme JS (Cart AJAX API needs no auth).
// Customer metafields are NOT — writing them needs the Admin API, whose access
// token must never ship inside public theme code. pushToCustomerMetafields()
// is therefore a placeholder until a backend (Shopify Flow / app-proxy holding
// the token server-side) copies these cart attributes onto the customer record
// in the `smoketo` namespace after order creation.
function pushQuizToCart(dietary,allergens,goals){
  var attrs={};
  if(dietary.length)attrs['dietary_preferences']=dietary.join(', ');
  if(allergens.length)attrs['allergens']=allergens.join(', ');
  if(goals.length)attrs['meal_notes']='Goal: '+goals.join(', ');
  if(!Object.keys(attrs).length)return;
  fetch(`https://${DOMAIN}/cart/update.js`,{
    method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({attributes:attrs})
  }).catch(function(){});
  {% if customer %}
  pushToCustomerMetafields(attrs);
  {% endif %}
}
function pushToCustomerMetafields(attrs){
  // TODO: wire up a backend (Shopify Flow trigger on order creation reading the
  // cart attributes set above, or an app-proxy endpoint) to write these onto
  // customer.metafields.smoketo.allergens / dietary_preferences / meal_notes.
  // Not implemented client-side — see comment above pushQuizToCart().
}
function tgl(el){el.classList.toggle('sel');}

// ── PARTICLES ──
function spawnParticles(){
  const c=document.getElementById('particles');
  for(let i=0;i<20;i++){
    const p=document.createElement('div');p.className='pt';
    p.style.left=Math.random()*100+'%';p.style.top=Math.random()*100+'%';
    p.style.setProperty('--d',(6+Math.random()*8)+'s');
    p.style.setProperty('--dl',(-Math.random()*10)+'s');
    c.appendChild(p);
  }
}

// ── REVEAL ──
function activateReveal(){
  const obs=new IntersectionObserver(entries=>{
    entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('vis');});
  },{threshold:.08});
  document.querySelectorAll('.reveal:not(.vis)').forEach(el=>obs.observe(el));
}

// ── TOAST ──
let _tt;
function showToast(title,msg){
  clearTimeout(_tt);
  document.getElementById('t-title').textContent=title;
  document.getElementById('t-msg').textContent=msg;
  document.getElementById('toast').classList.add('on');
  _tt=setTimeout(()=>document.getElementById('toast').classList.remove('on'),3200);
}


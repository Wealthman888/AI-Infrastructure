{%- comment -%}
  SmoKeto Landing Page Template
  Instructions:
  1. Go to Online Store > Themes > Crave > Edit Code
  2. Under Templates, click "Add a new template"
  3. Choose "page", name it "smoketo-main", click Create
  4. Delete all existing code and paste this entire file
  5. Save. Done — your page at /pages/smoketo-main will render perfectly.
{%- endcomment -%}

<style>

:root{
  --bg:#ffffff;--bg-off:#f7f5f2;--bg-dark:#1c1c1c;
  --border:#e8e8e8;--border-mid:#d0d0d0;
  --ember:#b85c2a;--ember-light:#d4703a;--ember-pale:#f5ebe3;
  --black:#1c1c1c;--gray-dark:#3d3d3d;--gray-mid:#6b6b6b;--gray-light:#a0a0a0;
  --green:#2d6a3f;--green-pale:#e8f4ec;--white:#ffffff;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--black);overflow-x:hidden;}

/* ── SHARE BANNER ── */
/* share-banner removed */

/* ── LOCATION GATE ── */
#gate{position:fixed;inset:0;background:rgba(247,245,242,.97);backdrop-filter:blur(16px);z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:24px;animation:fadeIn .5s ease;}
.gate-logo{height:80px;width:auto;object-fit:contain;border-radius:8px;animation:floatY 4s ease-in-out infinite;}
.gate-slogan{font-family:'Cormorant Garamond',serif;font-size:.82rem;letter-spacing:.17em;text-transform:uppercase;color:var(--gray-mid);}
.gate-slogan::before,.gate-slogan::after{content:'—';margin:0 7px;opacity:.35;}
#gate h2{font-family:'Playfair Display',serif;font-size:clamp(1.3rem,4vw,2rem);text-align:center;}
#gate p{color:var(--gray-mid);text-align:center;max-width:350px;font-size:.85rem;line-height:1.65;}
#zip-in,#gate-email{width:100%;max-width:260px;padding:12px 20px;border-radius:50px;border:1.5px solid var(--border-mid);background:#fff;text-align:center;font-size:1rem;letter-spacing:3px;outline:none;transition:border .3s;}
#zip-in:focus,#gate-email:focus{border-color:var(--ember);}
#zip-in::placeholder,#gate-email::placeholder{letter-spacing:1px;color:var(--gray-light);}
#gate-email{letter-spacing:normal;font-size:.92rem;}
.gate-btn{padding:12px 36px;border-radius:50px;background:var(--black);color:#fff;font-weight:700;font-size:.93rem;border:none;cursor:pointer;transition:transform .2s,box-shadow .2s;}
.gate-btn:hover{transform:scale(1.03);box-shadow:0 6px 24px rgba(0,0,0,.2);}
#gate-err{color:#c0392b;font-size:.76rem;display:none;text-align:center;max-width:320px;}
.gate-chips{display:flex;flex-wrap:wrap;justify-content:center;gap:6px;max-width:380px;}
.gate-chip{padding:4px 10px;border-radius:50px;border:1px solid var(--border);background:var(--bg-off);color:var(--gray-mid);font-size:.65rem;}

/* ── MODAL SYSTEM ── */
.modal-bd{position:fixed;inset:0;background:rgba(10,10,10,.74);backdrop-filter:blur(14px);z-index:9000;display:none;align-items:center;justify-content:center;padding:16px;}
.modal-bd.open{display:flex;}
.modal-box{background:#fff;border-radius:24px;width:100%;position:relative;box-shadow:0 32px 80px rgba(0,0,0,.22);animation:slideUp .4s cubic-bezier(.16,1,.3,1);}
.mclose{position:absolute;top:15px;right:16px;width:32px;height:32px;border-radius:50%;background:rgba(0,0,0,.07);border:none;color:var(--gray-dark);font-size:1rem;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s;z-index:2;}
.mclose:hover{background:rgba(0,0,0,.14);}

/* ── MEAL OVERLAY ── */
#meal-modal{z-index:9200;}
.meal-box{max-width:660px;}
.meal-img-wrap{width:100%;height:300px;overflow:hidden;position:relative;border-radius:24px 24px 0 0;background:var(--bg-off);}
.meal-img-wrap img{width:100%;height:100%;object-fit:cover;}
.meal-img-fallback{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:5rem;background:linear-gradient(135deg,#fff8f4,#f5ebe3);}
.meal-badge-bar{position:absolute;bottom:0;left:0;right:0;padding:13px 20px;background:linear-gradient(to top,rgba(0,0,0,.72),transparent);display:flex;gap:7px;}
.m-badge{padding:3px 10px;border-radius:20px;font-size:.6rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;}
.meal-body{padding:22px 24px 26px;}
.meal-body-name{font-family:'Playfair Display',serif;font-size:1.45rem;font-weight:900;margin-bottom:6px;}
.meal-body-desc{color:var(--gray-mid);font-size:.84rem;line-height:1.65;margin-bottom:18px;}
.macro-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:13px;background:var(--bg-off);border-radius:13px;border:1px solid var(--border);margin-bottom:18px;}
.mg-item{text-align:center;}
.mg-val{display:block;font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:700;color:var(--ember);}
.mg-lbl{display:block;font-size:.57rem;color:var(--gray-mid);letter-spacing:.07em;text-transform:uppercase;margin-top:2px;}
.overlay-hr{height:1px;background:var(--border);margin:0 0 16px;}
.var-wrap{margin-bottom:15px;}
.var-label{display:block;font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--gray-mid);margin-bottom:8px;}
.var-btns{display:flex;flex-wrap:wrap;gap:7px;}
.var-btn{padding:7px 13px;border-radius:50px;border:1.5px solid var(--border-mid);background:transparent;color:var(--gray-dark);font-size:.76rem;cursor:pointer;transition:all .2s;}
.var-btn:hover,.var-btn.sel{border-color:var(--ember);background:var(--ember-pale);color:var(--ember);font-weight:700;}
.diet-row{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:18px;}
.dtag{padding:3px 9px;border-radius:50px;border:1px solid var(--border);font-size:.67rem;color:var(--gray-dark);}
.meal-footer{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;}
.price-block .big-price{font-family:'Playfair Display',serif;font-size:1.85rem;font-weight:900;color:var(--ember);}
.price-block .price-note{font-size:.65rem;color:var(--gray-light);margin-top:2px;}
.qty-ctrl{display:flex;align-items:center;gap:8px;}
.qty-btn{width:30px;height:30px;border-radius:50%;border:1.5px solid var(--border-mid);background:transparent;font-size:1rem;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;}
.qty-btn:hover{border-color:var(--black);background:var(--bg-off);}
.qty-n{font-weight:700;font-size:.97rem;min-width:20px;text-align:center;}
.add-cart-btn{padding:12px 24px;border-radius:50px;background:var(--black);color:#fff;font-weight:700;font-size:.88rem;border:none;cursor:pointer;transition:all .25s;}
.add-cart-btn:hover{background:var(--ember);transform:scale(1.03);box-shadow:0 4px 20px rgba(184,92,42,.3);}

/* ── CART MODAL ── */
#cart-modal{z-index:9300;}
.cart-box{max-width:500px;max-height:88vh;display:flex;flex-direction:column;}
.cart-hdr{padding:20px 24px 13px;border-bottom:1px solid var(--border);flex-shrink:0;}
.cart-hdr h3{font-family:'Playfair Display',serif;font-size:1.3rem;}
.cart-body{flex:1;overflow-y:auto;padding:12px 24px;}
.cart-empty{text-align:center;padding:34px 0;color:var(--gray-mid);}
.cart-empty .ce-icon{font-size:2.8rem;margin-bottom:10px;}
.cart-row{display:flex;align-items:flex-start;gap:12px;padding:12px 0;border-bottom:1px solid var(--border);}
.cart-row:last-child{border-bottom:none;}
.cart-thumb{width:52px;height:52px;border-radius:9px;background:var(--bg-off);flex-shrink:0;overflow:hidden;display:flex;align-items:center;justify-content:center;font-size:1.5rem;}
.cart-thumb img{width:100%;height:100%;object-fit:cover;}
.cart-info{flex:1;min-width:0;}
.cart-name{font-weight:700;font-size:.83rem;margin-bottom:2px;}
.cart-var{font-size:.69rem;color:var(--gray-mid);margin-bottom:5px;}
.cart-qty{display:flex;align-items:center;gap:6px;}
.cq{width:22px;height:22px;border-radius:50%;border:1px solid var(--border-mid);background:transparent;font-size:.82rem;cursor:pointer;display:flex;align-items:center;justify-content:center;}
.cq:hover{background:var(--bg-off);}
.cart-right{text-align:right;flex-shrink:0;}
.cart-price{font-family:'Playfair Display',serif;font-size:.93rem;color:var(--ember);font-weight:700;}
.cart-rm{background:none;border:none;color:var(--gray-light);cursor:pointer;font-size:.72rem;margin-top:3px;display:block;}
.cart-rm:hover{color:#c0392b;}
.cart-ftr{padding:13px 24px 20px;border-top:1px solid var(--border);flex-shrink:0;}
.cart-sub{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;}
.cart-sub-lbl{font-size:.84rem;color:var(--gray-mid);}
.cart-sub-val{font-family:'Playfair Display',serif;font-size:1.25rem;font-weight:700;}
.checkout-btn{width:100%;padding:13px;border-radius:50px;background:var(--black);color:#fff;font-weight:700;font-size:.94rem;border:none;cursor:pointer;transition:all .25s;display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:8px;}
.checkout-btn:hover{background:var(--ember);box-shadow:0 4px 20px rgba(184,92,42,.3);}
.continue-btn{width:100%;padding:10px;border-radius:50px;border:1.5px solid var(--border-mid);background:transparent;color:var(--gray-dark);font-size:.82rem;cursor:pointer;}
.cart-note{font-size:.65rem;color:var(--gray-light);text-align:center;margin-top:8px;}
.cart-freeship-track{height:6px;background:var(--bg-off);border-radius:50px;overflow:hidden;margin-top:8px;}
.cart-freeship-fill{height:100%;width:0%;background:var(--ember);border-radius:50px;transition:width .3s ease,background .3s;}
.cart-freeship-fill.complete{background:var(--green);}

/* ── AUTH MODAL ── */
#auth-modal{z-index:9400;}
.auth-box{max-width:420px;overflow:hidden;}
.auth-tabs{display:flex;border-bottom:1px solid var(--border);}
.atab{flex:1;padding:16px;font-size:.84rem;font-weight:600;cursor:pointer;border:none;background:transparent;color:var(--gray-mid);transition:all .2s;border-bottom:2px solid transparent;}
.atab.on{color:var(--ember);border-bottom-color:var(--ember);}
.auth-pane{padding:24px 26px 28px;}
.auth-pane h3{font-family:'Playfair Display',serif;font-size:1.3rem;margin-bottom:6px;}
.auth-pane p{font-size:.79rem;color:var(--gray-mid);margin-bottom:18px;line-height:1.55;}
.fg{margin-bottom:12px;}
.fg label{display:block;font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--gray-mid);margin-bottom:5px;}
.fi{width:100%;padding:10px 13px;border-radius:10px;border:1.5px solid var(--border-mid);background:#fff;color:var(--black);font-size:.86rem;outline:none;transition:border .3s;font-family:'DM Sans',sans-serif;}
.fi:focus{border-color:var(--ember);}
.fg-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.auth-submit{width:100%;padding:12px;border-radius:50px;background:var(--black);color:#fff;font-weight:700;font-size:.88rem;border:none;cursor:pointer;transition:background .25s;margin-top:4px;}
.auth-submit:hover{background:var(--ember);}
.auth-or{display:flex;align-items:center;gap:10px;margin:13px 0;color:var(--gray-light);font-size:.72rem;}
.auth-or::before,.auth-or::after{content:'';flex:1;height:1px;background:var(--border);}
.shopify-btn{width:100%;padding:10px;border-radius:50px;border:1.5px solid var(--border-mid);background:transparent;color:var(--gray-dark);font-size:.82rem;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:7px;}
.shopify-btn:hover{border-color:var(--black);background:var(--bg-off);}
.auth-switch{font-size:.74rem;color:var(--gray-mid);text-align:center;margin-top:11px;}
.auth-switch span{color:var(--ember);cursor:pointer;font-weight:600;}
.forgot-lnk{font-size:.71rem;color:var(--ember);cursor:pointer;display:block;text-align:right;margin-top:-6px;margin-bottom:13px;}

/* ── SUBSCRIPTION MODAL ── */
#sub-modal{z-index:9100;}
.sub-box{max-width:760px;padding:32px 32px 36px;max-height:90vh;overflow-y:auto;}
.sub-box h2{font-family:'Playfair Display',serif;font-size:1.7rem;margin-bottom:7px;}
.sub-desc{color:var(--gray-mid);font-size:.86rem;margin-bottom:24px;}
.sub-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:11px;margin-bottom:24px;}
.sub-card{border:2px solid var(--border);border-radius:15px;padding:18px 14px;text-align:center;cursor:pointer;transition:all .25s;position:relative;}
.sub-card:hover{border-color:var(--ember);background:var(--ember-pale);}
.sub-card.sel{border-color:var(--ember);background:var(--ember-pale);}
.sub-badge{position:absolute;top:-10px;left:50%;transform:translateX(-50%);background:var(--ember);color:#fff;padding:3px 12px;border-radius:50px;font-size:.59rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;}
.sub-meals{font-family:'Playfair Display',serif;font-size:2.5rem;font-weight:900;color:var(--ember);line-height:1;}
.sub-freq{font-size:.7rem;color:var(--gray-mid);margin-bottom:8px;}
.sub-price{font-size:1.1rem;font-weight:700;color:var(--black);}
.sub-per{font-size:.65rem;color:var(--gray-mid);}
.sub-save{font-size:.65rem;color:var(--green);font-weight:700;margin-top:4px;}
.sub-feats{background:var(--bg-off);border-radius:13px;padding:16px;margin-bottom:20px;}
.sub-feats h4{font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--gray-mid);margin-bottom:10px;}
.sub-feat-list{display:grid;grid-template-columns:1fr 1fr;gap:6px;}
.sfl{display:flex;align-items:flex-start;gap:6px;font-size:.78rem;color:var(--gray-dark);}
.sfl-chk{color:var(--green);font-weight:700;flex-shrink:0;}
.sub-go{width:100%;padding:14px;border-radius:50px;background:var(--black);color:#fff;font-weight:700;font-size:.96rem;border:none;cursor:pointer;transition:all .25s;display:flex;align-items:center;justify-content:center;gap:8px;}
.sub-go:hover{background:var(--ember);box-shadow:0 6px 28px rgba(184,92,42,.35);}
.sub-go-note{font-size:.65rem;color:var(--gray-light);text-align:center;margin-top:8px;}

/* ── SURVEY MODAL ── */
#survey-modal{z-index:9050;}
.survey-box{max-width:520px;padding:34px 32px 32px;}
.survey-prog{display:flex;gap:5px;margin-bottom:22px;}
.sp-dot{flex:1;height:3px;border-radius:4px;background:var(--border);transition:background .4s;}
.sp-dot.done{background:var(--ember);}
.survey-step{display:none;}
.survey-step.on{display:block;animation:fadeIn .3s ease;}
.sv-title{font-family:'Playfair Display',serif;font-size:1.35rem;margin-bottom:6px;}
.sv-sub{color:var(--gray-mid);font-size:.83rem;margin-bottom:22px;line-height:1.55;}
.chip-grid{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px;}
.chip{padding:8px 13px;border-radius:50px;border:1.5px solid var(--border);background:transparent;color:var(--gray-dark);font-size:.79rem;cursor:pointer;transition:all .2s;display:flex;align-items:center;gap:6px;}
.chip:hover,.chip.sel{border-color:var(--ember);background:var(--ember-pale);color:var(--ember);}
.sv-btns{display:flex;gap:9px;justify-content:flex-end;}
.btn-next{padding:9px 22px;border-radius:50px;background:var(--black);color:#fff;font-size:.83rem;font-weight:600;border:none;cursor:pointer;transition:all .2s;}
.btn-next:hover{transform:scale(1.03);}
.btn-back{padding:9px 18px;border-radius:50px;background:var(--bg-off);color:var(--gray-mid);font-size:.83rem;font-weight:600;border:none;cursor:pointer;}
.survey-result{text-align:center;padding:8px 0;}

/* ── NAV ── */
nav{position:fixed;top:0;left:0;right:0;z-index:1000;display:flex;align-items:center;justify-content:space-between;padding:13px 5%;transition:all .4s;background:transparent;}
nav.scrolled{background:rgba(255,255,255,.97);backdrop-filter:blur(16px);padding:10px 5%;border-bottom:1px solid var(--border);}
.nav-logo{display:flex;align-items:center;gap:10px;text-decoration:none;}
.nav-logo:hover .nav-brand{color:var(--ember);}
.hero-logo{
  display:block !important;
  width:210px;
  height:auto;
  object-fit:contain;
  border-radius:12px;
  margin-bottom:20px;
  box-shadow:0 4px 20px rgba(0,0,0,0.12);
  background:var(--bg-off);
}

.nav-brand{font-family:'Playfair Display',serif;font-size:1.25rem;font-weight:900;color:var(--black);}
.nav-brand em{font-style:italic;color:var(--ember);}
.nav-tagline{font-size:.54rem;font-weight:600;letter-spacing:.13em;text-transform:uppercase;color:var(--gray-mid);display:block;margin-top:2px;}
.nav-links{display:flex;gap:26px;list-style:none;}
.nav-links a{color:var(--gray-dark);text-decoration:none;font-size:.82rem;font-weight:500;transition:color .2s;}
.nav-links a:hover{color:var(--black);}
.nav-right{display:flex;align-items:center;gap:9px;}
.nav-btn{padding:8px 14px;border-radius:50px;border:1.5px solid var(--border-mid);background:transparent;color:var(--gray-dark);font-size:.76rem;font-weight:600;cursor:pointer;transition:all .2s;display:inline-flex;align-items:center;gap:5px;}
.nav-btn:hover{border-color:var(--black);color:var(--black);}
.cart-wrap{position:relative;display:inline-flex;}
.cart-dot{position:absolute;top:-5px;right:-5px;width:17px;height:17px;border-radius:50%;background:var(--ember);color:#fff;font-size:.57rem;font-weight:700;display:none;align-items:center;justify-content:center;}
.cart-dot.on{display:flex;}
.btn-primary{padding:9px 19px;border-radius:50px;background:var(--black);color:#fff;font-size:.82rem;font-weight:700;border:none;cursor:pointer;transition:all .25s;}
.btn-primary:hover{background:var(--ember);transform:scale(1.03);}
.hamburger{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:5px;}
.hamburger span{display:block;width:21px;height:2px;background:var(--black);border-radius:2px;}

/* ── MOBILE MENU ── */
.mob-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.3);z-index:8499;}
.mob-overlay.on{display:block;}
.mob-menu{position:fixed;top:0;right:0;bottom:0;width:250px;background:#fff;border-left:1px solid var(--border);z-index:8500;transform:translateX(100%);transition:transform .4s cubic-bezier(.16,1,.3,1);padding:72px 26px 34px;}
.mob-menu.on{transform:translateX(0);}
.mob-menu ul{list-style:none;}
.mob-menu ul li{margin-bottom:20px;}
.mob-menu ul a{color:var(--black);text-decoration:none;font-size:1.05rem;font-weight:500;}
.mob-menu ul a:hover{color:var(--ember);}

/* ── HERO ── */
.hero{min-height:100vh;display:grid;place-items:center;position:relative;overflow:hidden;padding:130px 5% 90px;background:var(--bg);}
.hero-bg{position:absolute;inset:0;background:linear-gradient(160deg,#fff8f4,#fff 45%,#f5f0eb 100%);z-index:0;}
.smoke-orb{position:absolute;border-radius:50%;filter:blur(80px);animation:smokeDrift linear infinite;}
.s1{width:55%;height:55%;left:45%;top:10%;background:radial-gradient(ellipse,rgba(184,92,42,.08),transparent 70%);animation-duration:14s;opacity:.7;}
.s2{width:40%;height:60%;left:55%;top:-5%;background:radial-gradient(ellipse,rgba(220,140,60,.05),transparent 65%);animation-duration:18s;animation-delay:-6s;opacity:.5;}
.particles{position:absolute;inset:0;pointer-events:none;z-index:1;}
.pt{position:absolute;width:3px;height:3px;background:var(--ember);border-radius:50%;animation:floatP var(--d,8s) ease-in-out infinite var(--dl,0s);opacity:0;}
.hero-inner{position:relative;z-index:2;display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;max-width:1240px;width:100%;}
.hero-left{animation:sLeft .9s cubic-bezier(.16,1,.3,1) both;}
.hero-badge{display:inline-flex;align-items:center;gap:7px;padding:5px 14px;border-radius:50px;border:1px solid rgba(184,92,42,.2);background:rgba(184,92,42,.06);font-size:.7rem;font-weight:600;color:var(--ember);letter-spacing:.08em;text-transform:uppercase;margin-bottom:18px;}
.badge-dot{width:7px;height:7px;border-radius:50%;background:var(--green);animation:pulse 1.5s ease infinite;box-shadow:0 0 0 3px rgba(45,106,63,.2);}
h1{font-family:'Playfair Display',serif;font-size:clamp(2.1rem,5vw,3.8rem);line-height:1.08;font-weight:900;color:var(--black);margin-bottom:16px;}
h1 em{font-style:italic;color:var(--ember);font-weight:400;}
.hero-sub{color:var(--gray-mid);font-size:clamp(.9rem,1.4vw,1.04rem);line-height:1.7;max-width:420px;margin-bottom:28px;}
.hero-actions{display:flex;gap:11px;flex-wrap:wrap;align-items:center;}
.btn-ghost{padding:12px 24px;border-radius:50px;border:1.5px solid var(--border-mid);background:transparent;color:var(--black);font-size:.85rem;font-weight:600;cursor:pointer;transition:all .25s;}
.btn-ghost:hover{border-color:var(--black);background:var(--bg-off);}
.btn-lg{padding:13px 30px;font-size:.95rem;}
.cta-main{background:var(--black);color:#fff;border:none;animation:ctaPulse 3s ease-in-out infinite;}
.cta-main:hover{background:var(--ember);transform:scale(1.03);box-shadow:0 4px 22px rgba(184,92,42,.35);}
.hero-trust{margin-top:32px;display:flex;align-items:center;gap:14px;padding-top:24px;border-top:1px solid var(--border);flex-wrap:wrap;}
.tn{font-family:'Playfair Display',serif;font-size:1.35rem;font-weight:700;color:var(--ember);}
.tl{font-size:.66rem;color:var(--gray-mid);letter-spacing:.05em;}
.tdiv{height:24px;width:1px;background:var(--border);}
.hero-right{position:relative;animation:sRight .9s cubic-bezier(.16,1,.3,1) .15s both;}
.scene{position:relative;width:100%;aspect-ratio:1;display:flex;align-items:center;justify-content:center;}
.wisps{position:absolute;bottom:28%;left:50%;transform:translateX(-50%);width:78%;height:58%;pointer-events:none;z-index:4;}
.wisp{position:absolute;bottom:0;border-radius:50%;background:radial-gradient(ellipse,rgba(184,92,42,.07),transparent 70%);filter:blur(14px);animation:wispUp linear infinite;transform-origin:bottom center;}
.w1{width:56px;height:86px;left:18%;animation-duration:5s;}
.w2{width:38px;height:66px;left:38%;animation-duration:6.5s;animation-delay:-1.5s;}
.w3{width:64px;height:96px;left:54%;animation-duration:7s;animation-delay:-3s;}
.w4{width:32px;height:56px;left:70%;animation-duration:5.5s;animation-delay:-2s;}
.glow-ring{position:absolute;inset:-8%;border-radius:50%;background:radial-gradient(ellipse at 55% 45%,rgba(184,92,42,.09),transparent 65%);animation:glowPulse 4s ease-in-out infinite;pointer-events:none;}
.hero-card{position:relative;z-index:3;width:86%;aspect-ratio:1;border-radius:26px;overflow:hidden;box-shadow:0 30px 76px rgba(184,92,42,.17),0 8px 22px rgba(0,0,0,.09);animation:cardFloat 6s ease-in-out infinite;border:1px solid rgba(184,92,42,.12);}
.hero-card img{width:100%;height:100%;object-fit:cover;animation:subtleZoom 12s ease-in-out infinite alternate;}
.heat-shimmer{position:absolute;inset:0;background:linear-gradient(to bottom,transparent 50%,rgba(255,200,120,.04) 70%,transparent 100%);animation:shimmer 3s ease-in-out infinite;pointer-events:none;}
.fbadge{position:absolute;z-index:5;display:flex;align-items:center;gap:6px;padding:7px 13px;border-radius:50px;font-size:.71rem;font-weight:700;white-space:nowrap;box-shadow:0 6px 20px rgba(0,0,0,.1);backdrop-filter:blur(12px);animation:badgeFloat 3.5s ease-in-out infinite;}
.fb-keto{top:7%;right:2%;background:rgba(255,255,255,.92);border:1px solid rgba(184,92,42,.2);color:var(--ember);}
.fb-smoke{bottom:18%;left:2%;background:var(--black);color:#fff;animation-delay:-1.8s;}
.fb-fresh{top:38%;right:2%;background:rgba(45,106,63,.9);color:#fff;animation-delay:-1s;}
.fb-dot{width:6px;height:6px;border-radius:50%;background:var(--ember);animation:pulse 1.5s ease infinite;flex-shrink:0;}
.macro-pill{position:absolute;bottom:-14px;left:50%;transform:translateX(-50%);z-index:6;display:flex;align-items:center;background:rgba(255,255,255,.96);border:1px solid var(--border);border-radius:50px;padding:9px 14px;box-shadow:0 8px 26px rgba(0,0,0,.1);white-space:nowrap;animation:pillUp 1s cubic-bezier(.16,1,.3,1) .8s both;max-width:calc(100% + 20px);overflow:hidden;}
.mp-item{text-align:center;padding:0 9px;}
.mp-v{display:block;font-weight:700;font-size:.9rem;color:var(--ember);font-family:'Playfair Display',serif;}
.mp-l{display:block;font-size:.58rem;color:var(--gray-mid);letter-spacing:.06em;text-transform:uppercase;margin-top:1px;}
.mp-div{width:1px;height:24px;background:var(--border);}

/* ── FEATURES ── */
.feats{display:flex;flex-wrap:wrap;border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:var(--bg-off);}
.feat{flex:1 1 170px;padding:24px 20px;display:flex;align-items:center;gap:12px;border-right:1px solid var(--border);transition:background .3s;}
.feat:last-child{border-right:none;}
.feat:hover{background:var(--ember-pale);}
.feat-icon{font-size:1.35rem;flex-shrink:0;}
.feat-h{font-size:.81rem;font-weight:700;margin-bottom:2px;}
.feat-p{font-size:.69rem;color:var(--gray-mid);line-height:1.5;}

/* ── HOW IT WORKS ── */
.how{padding:86px 5%;background:var(--bg);}
.sec-lbl{font-size:.66rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--ember);margin-bottom:10px;display:block;}
.sec-title{font-family:'Playfair Display',serif;font-size:clamp(1.65rem,4vw,2.75rem);font-weight:700;color:var(--black);margin-bottom:10px;line-height:1.15;}
.sec-sub{color:var(--gray-mid);max-width:480px;line-height:1.7;font-size:.89rem;margin-bottom:46px;}
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:1px;border:1px solid var(--border);border-radius:18px;overflow:hidden;background:var(--border);}
.step{padding:38px 26px;background:var(--bg);position:relative;overflow:hidden;transition:background .3s;}
.step::after{content:'';position:absolute;inset:0;background:var(--ember-pale);opacity:0;transition:opacity .3s;}
.step:hover::after{opacity:1;}
.step-n{font-family:'Cormorant Garamond',serif;font-size:3.4rem;font-weight:300;color:rgba(184,92,42,.15);line-height:1;margin-bottom:14px;display:block;position:relative;z-index:1;}
.step-ico{font-size:1.7rem;margin-bottom:10px;display:block;position:relative;z-index:1;}
.step-h{font-size:.94rem;font-weight:700;margin-bottom:6px;position:relative;z-index:1;}
.step-p{font-size:.79rem;color:var(--gray-mid);line-height:1.65;position:relative;z-index:1;}

/* ── MENU ── */
.menu-sec{padding:0;background:#f8f7f5;}
.menu-sticky-bar{position:sticky;top:0;z-index:200;background:#fff;border-bottom:1px solid var(--border);padding:0 5%;}
.menu-sticky-inner{display:flex;align-items:center;justify-content:space-between;gap:16px;max-width:1280px;margin:0 auto;}
.filter-scroll{display:flex;gap:8px;overflow-x:auto;padding:14px 0;scrollbar-width:none;-ms-overflow-style:none;flex:1;}
.filter-scroll::-webkit-scrollbar{display:none;}
.ftab{padding:8px 18px;border-radius:50px;border:1.5px solid var(--border-mid);background:#fff;color:var(--gray-mid);font-size:.78rem;font-weight:600;cursor:pointer;transition:all .2s;white-space:nowrap;flex-shrink:0;}
.ftab.on,.ftab:hover{border-color:var(--black);background:var(--black);color:#fff;}
.diet-filters{display:flex;gap:6px;flex-shrink:0;padding:14px 0;}
.dfil{padding:7px 13px;border-radius:50px;border:1.5px solid var(--border);background:#fff;color:var(--gray-mid);font-size:.72rem;font-weight:600;cursor:pointer;transition:all .2s;white-space:nowrap;display:flex;align-items:center;gap:5px;}
.dfil.on{border-color:var(--green);background:var(--green-pale);color:var(--green);}
.menu-body{padding:32px 5% 80px;max-width:1280px;margin:0 auto;}
.menu-count{font-size:.8rem;color:var(--gray-mid);margin-bottom:20px;}
.meal-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
@media(max-width:1100px){.meal-grid{grid-template-columns:repeat(3,1fr);}}
@media(max-width:760px){.meal-grid{grid-template-columns:repeat(2,1fr);gap:12px;}}
@media(max-width:480px){.meal-grid{grid-template-columns:1fr 1fr;gap:10px;}}

/* CooKunity-style meal card */
.meal-card{border-radius:16px;background:#fff;border:1.5px solid var(--border);overflow:hidden;transition:transform .25s,box-shadow .25s,border-color .25s;cursor:pointer;display:flex;flex-direction:column;position:relative;}
.meal-card:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(0,0,0,.11);border-color:rgba(0,0,0,.15);}
.mc-img-wrap{width:100%;aspect-ratio:4/3;background:var(--bg-off);position:relative;overflow:hidden;flex-shrink:0;}
.mc-img-wrap img{width:100%;height:100%;object-fit:cover;transition:transform .5s;}
.meal-card:hover .mc-img-wrap img{transform:scale(1.04);}
.mc-img-fallback{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:3rem;background:linear-gradient(135deg,#fff8f4,#f5ebe3);}
.mc-badge{position:absolute;top:10px;left:10px;padding:4px 10px;border-radius:20px;font-size:.58rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;}
.mc-b-new{background:var(--ember);color:#fff;}
.mc-b-popular{background:#1c1c1c;color:#fff;}
.mc-b-keto{background:var(--green-pale);color:var(--green);}
.mc-b-breakfast{background:#e8f0fb;color:#2c5fad;}
.mc-b-seafood{background:#faf0e8;color:#c0692a;}
.mc-quick-add{position:absolute;bottom:10px;right:10px;width:36px;height:36px;border-radius:50%;background:#fff;border:none;box-shadow:0 2px 12px rgba(0,0,0,.15);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:1.1rem;opacity:0;transform:scale(.8);transition:all .2s;}
.meal-card:hover .mc-quick-add{opacity:1;transform:scale(1);}
.mc-quick-add:hover{background:var(--black);color:#fff;}
.mc-body{padding:14px 14px 16px;display:flex;flex-direction:column;flex:1;}
.mc-chef{display:flex;align-items:center;gap:6px;margin-bottom:7px;}
.mc-chef-av{width:22px;height:22px;border-radius:50%;background:var(--ember-pale);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:.65rem;flex-shrink:0;}
.mc-chef-name{font-size:.67rem;color:var(--gray-mid);font-weight:500;}
.mc-name{font-weight:800;font-size:.9rem;color:var(--black);line-height:1.3;margin-bottom:6px;}
.mc-stars{display:flex;align-items:center;gap:4px;margin-bottom:8px;}
.mc-star-row{color:#f5a623;font-size:.72rem;letter-spacing:1px;}
.mc-rating{font-size:.68rem;color:var(--gray-mid);}
.mc-tags{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:10px;}
.mc-tag{padding:3px 8px;border-radius:20px;font-size:.6rem;font-weight:600;background:var(--bg-off);color:var(--gray-mid);border:1px solid var(--border);}
.mc-tag-keto{background:var(--green-pale);color:var(--green);border-color:rgba(45,106,63,.15);}
.mc-tag-gf{background:#fff7ed;color:#c2570a;border-color:rgba(194,87,10,.12);}
.mc-tag-hp{background:#f0f4ff;color:#3b5bdb;border-color:rgba(59,91,219,.12);}
.mc-macros{display:flex;gap:0;background:var(--bg-off);border-radius:10px;padding:8px 10px;margin-bottom:12px;border:1px solid var(--border);}
.mc-macro{flex:1;text-align:center;position:relative;}
.mc-macro+.mc-macro::before{content:'';position:absolute;left:0;top:50%;transform:translateY(-50%);width:1px;height:60%;background:var(--border);}
.mc-mv{display:block;font-weight:800;font-size:.88rem;color:var(--black);}
.mc-ml{display:block;font-size:.56rem;color:var(--gray-light);text-transform:uppercase;letter-spacing:.06em;margin-top:1px;}
.mc-footer{display:flex;align-items:center;justify-content:center;margin-top:auto;}
.mc-add-btn{width:100%;padding:10px 16px;border-radius:50px;background:var(--black);color:#fff;font-size:.78rem;font-weight:700;border:none;cursor:pointer;transition:all .2s;}
.mc-add-btn:hover{background:var(--ember);}

/* Menu header */
.menu-hero{background:var(--black);padding:40px 5% 32px;text-align:center;}
.menu-hero-label{font-size:.65rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.45);margin-bottom:8px;}
.menu-hero-title{font-family:'Playfair Display',serif;font-size:clamp(1.6rem,4vw,2.8rem);color:#fff;font-weight:900;margin-bottom:8px;}
.menu-hero-title em{color:var(--ember);font-style:italic;}
.menu-hero-sub{color:rgba(255,255,255,.5);font-size:.85rem;max-width:440px;margin:0 auto;}
.menu-cutoff{display:inline-flex;align-items:center;gap:6px;margin-top:14px;padding:6px 14px;border-radius:50px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.6);font-size:.72rem;}
.cutoff-dot{width:6px;height:6px;border-radius:50%;background:#4ade80;animation:pulse 1.5s ease infinite;}


/* ── SUBSCRIPTION SECTION ── */
.sub-sec{padding:86px 5%;background:var(--bg);}
.sub-hero{background:linear-gradient(135deg,#1c1c1c,#2d2018);border-radius:26px;padding:50px 42px;display:flex;align-items:center;justify-content:space-between;gap:28px;flex-wrap:wrap;max-width:1100px;margin:0 auto;position:relative;overflow:hidden;}
.sub-hero::before{content:'';position:absolute;top:-40%;right:-5%;width:360px;height:360px;background:radial-gradient(ellipse,rgba(184,92,42,.16),transparent 65%);pointer-events:none;}
.sub-left{flex:1;min-width:230px;}
.sub-left .sec-lbl{color:rgba(184,92,42,.75);}
.sub-left h2{font-family:'Playfair Display',serif;font-size:clamp(1.5rem,3.5vw,2.4rem);color:#fff;margin-bottom:9px;line-height:1.15;}
.sub-left h2 em{font-style:italic;color:var(--ember);}
.sub-left p{color:rgba(255,255,255,.48);font-size:.86rem;line-height:1.65;}
.sub-mini{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;min-width:230px;}
.smc{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:13px;padding:14px 12px;text-align:center;cursor:pointer;transition:all .2s;}
.smc:hover,.smc.sel{background:rgba(184,92,42,.18);border-color:rgba(184,92,42,.5);}
.smc-meals{font-family:'Playfair Display',serif;font-size:1.8rem;font-weight:900;color:var(--ember);}
.smc-freq{font-size:.63rem;color:rgba(255,255,255,.38);margin-bottom:4px;}
.smc-price{font-size:.87rem;font-weight:700;color:#fff;}
.smc-per{font-size:.6rem;color:rgba(255,255,255,.32);}
.smc-save{font-size:.6rem;color:#7ec896;font-weight:700;margin-top:3px;}
.sub-action{display:flex;flex-direction:column;gap:9px;align-items:flex-start;min-width:170px;}
.sub-cta{padding:14px 26px;border-radius:50px;background:var(--ember);color:#fff;font-weight:700;font-size:.95rem;border:none;cursor:pointer;transition:all .25s;white-space:nowrap;}
.sub-cta:hover{transform:scale(1.04);box-shadow:0 6px 28px rgba(184,92,42,.45);}
.sub-fine{font-size:.65rem;color:rgba(255,255,255,.32);}

/* ── REVIEWS ── */
.reviews{padding:86px 5%;background:var(--bg-off);overflow:hidden;}
.rev-track-wrap{overflow:hidden;-webkit-mask:linear-gradient(90deg,transparent,black 10%,black 90%,transparent);mask:linear-gradient(90deg,transparent,black 10%,black 90%,transparent);margin-top:38px;}
.rev-track{display:flex;gap:14px;animation:scrollX 36s linear infinite;width:max-content;}
.rev-track:hover{animation-play-state:paused;}
.rev-card{flex-shrink:0;width:270px;background:#fff;border:1px solid var(--border);border-radius:13px;padding:18px;}
.rev-stars{color:var(--ember);font-size:.83rem;margin-bottom:9px;letter-spacing:2px;}
.rev-text{font-size:.79rem;color:var(--gray-dark);line-height:1.6;margin-bottom:11px;}
.rev-author{display:flex;align-items:center;gap:8px;}
.rev-av{width:30px;height:30px;border-radius:50%;background:var(--bg-off);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:.86rem;}
.rev-name{font-size:.75rem;font-weight:700;}
.rev-loc{font-size:.63rem;color:var(--gray-mid);}

/* ── LOCATION ── */
.loc-sec{padding:70px 5%;background:var(--bg);text-align:center;}
.loc-badge{display:inline-flex;align-items:center;gap:8px;padding:8px 18px;border-radius:50px;border:1px solid var(--border);background:var(--bg-off);margin-bottom:22px;font-size:.82rem;font-weight:600;}
.zone-chips{display:flex;flex-wrap:wrap;justify-content:center;gap:6px;margin-top:18px;max-width:600px;margin-left:auto;margin-right:auto;}
.zchip{padding:4px 11px;border-radius:50px;border:1px solid var(--border-mid);background:#fff;font-size:.68rem;color:var(--gray-dark);}

/* ── CTA FOOTER BANNER ── */
.cta-sec{padding:86px 5%;background:var(--black);text-align:center;position:relative;overflow:hidden;}
.cta-offer{display:inline-block;padding:7px 18px;border-radius:50px;background:rgba(184,92,42,.15);border:1px solid rgba(184,92,42,.4);color:#e8a878;font-size:.79rem;font-weight:700;letter-spacing:.05em;margin-bottom:22px;}
.cta-sec .sec-title{color:#fff;}
.cta-sec .sec-title em{color:var(--ember);}
.cta-sec .sec-sub{color:rgba(255,255,255,.5);margin:0 auto 28px;max-width:480px;}
.btn-white{background:#fff;color:var(--black);padding:13px 28px;border-radius:50px;font-size:.93rem;font-weight:700;border:none;cursor:pointer;transition:all .25s;}
.btn-white:hover{background:var(--ember);color:#fff;}
.btn-outline-w{border:1.5px solid rgba(255,255,255,.25);background:transparent;color:rgba(255,255,255,.7);padding:12px 24px;border-radius:50px;font-size:.86rem;font-weight:600;cursor:pointer;transition:all .25s;}
.btn-outline-w:hover{border-color:rgba(255,255,255,.6);color:#fff;background:rgba(255,255,255,.07);}

/* ── FOOTER ── */
footer{background:var(--bg-off);border-top:1px solid var(--border);padding:48px 5% 24px;}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:30px;margin-bottom:36px;}
.foot-logo{height:44px;width:auto;object-fit:contain;border-radius:6px;display:block;}
.foot-tagline{font-family:'Cormorant Garamond',serif;font-size:.7rem;letter-spacing:.15em;text-transform:uppercase;color:var(--gray-light);margin-top:4px;display:block;}
.foot-p{font-size:.76rem;color:var(--gray-mid);line-height:1.7;max-width:230px;margin-top:11px;}
.foot-col h5{font-size:.66rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--gray-mid);margin-bottom:11px;}
.foot-col ul{list-style:none;}
.foot-col ul li{margin-bottom:7px;}
.foot-col ul a{color:var(--gray-dark);text-decoration:none;font-size:.77rem;transition:color .2s;}
.foot-col ul a:hover{color:var(--black);}
.foot-bottom{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;padding-top:18px;border-top:1px solid var(--border);}
.foot-bottom p{font-size:.69rem;color:var(--gray-light);}
.socials{display:flex;gap:7px;}
.soc{width:28px;height:28px;border-radius:50%;border:1px solid var(--border-mid);display:flex;align-items:center;justify-content:center;font-size:.74rem;color:var(--gray-mid);text-decoration:none;transition:all .2s;}
.soc:hover{border-color:var(--black);color:var(--black);}

/* ── CART BAR ── */
.cart-bar{display:none!important;}
.cb-count{font-weight:700;font-size:.82rem;}
.cb-total{color:var(--gray-mid);font-size:.74rem;margin-top:2px;}
.cb-btn{padding:9px 22px;border-radius:50px;background:var(--black);color:#fff;font-weight:700;font-size:.83rem;border:none;cursor:pointer;transition:all .2s;}
.cb-btn:hover{background:var(--ember);}

/* ── TOAST ── */
.toast{position:fixed;bottom:70px;right:16px;background:#fff;border:1px solid var(--border);border-radius:13px;padding:11px 15px;z-index:9999;transform:translateX(120%);transition:transform .4s cubic-bezier(.16,1,.3,1);min-width:190px;box-shadow:0 8px 30px rgba(0,0,0,.11);}
.toast.on{transform:translateX(0);}
.toast-title{font-size:.79rem;font-weight:700;margin-bottom:2px;}
.toast-msg{font-size:.69rem;color:var(--gray-mid);}

/* ── BOX TALLY ── */
#sk-tally{display:none!important;}
#sk-tally:hover{transform:translateY(-2px);}
#sk-tally .skt-text{display:flex;flex-direction:column;line-height:1.3;}
#sk-tally .skt-label{font-size:.86rem;font-weight:800;}
#sk-tally .skt-sub{font-size:.68rem;color:rgba(255,255,255,.5);}
#sk-tally .skt-bar{width:54px;height:5px;background:rgba(255,255,255,.2);border-radius:50px;overflow:hidden;flex-shrink:0;}
#sk-tally .skt-fill{height:100%;background:var(--ember);border-radius:50px;transition:width .3s;}
#sk-tally.full .skt-label{color:#4ade80;}
#sk-tally.full .skt-fill{background:#4ade80;}
@media(max-width:540px){#sk-tally{bottom:76px;right:14px;padding:9px 16px;}#sk-tally .skt-label{font-size:.78rem;}}

/* ── REVEAL ── */
.reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s cubic-bezier(.16,1,.3,1);}
.reveal.vis{opacity:1;transform:none;}
.rd1{transition-delay:.1s;}.rd2{transition-delay:.2s;}.rd3{transition-delay:.3s;}

/* ── ANIMATIONS ── */
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes slideUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:none}}
@keyframes sLeft{from{opacity:0;transform:translateX(-38px)}to{opacity:1;transform:none}}
@keyframes sRight{from{opacity:0;transform:translateX(38px)}to{opacity:1;transform:none}}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
@keyframes scrollX{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@keyframes floatP{0%{opacity:0;transform:translateY(0)}20%{opacity:.5}80%{opacity:.2}100%{opacity:0;transform:translateY(-110px)}}
@keyframes smokeDrift{0%{transform:scale(1) translate(0,0);opacity:.6}33%{transform:scale(1.08) translate(2%,3%);opacity:.8}100%{transform:scale(1) translate(0,0);opacity:.6}}
@keyframes wispUp{0%{transform:translateY(0) scaleX(1);opacity:0}15%{opacity:1}80%{opacity:.3}100%{transform:translateY(-190px) scaleX(.3) rotate(8deg);opacity:0}}
@keyframes glowPulse{0%,100%{opacity:.6;transform:scale(1)}50%{opacity:1;transform:scale(1.04)}}
@keyframes cardFloat{0%,100%{transform:translateY(0) rotate(0)}30%{transform:translateY(-8px) rotate(.4deg)}70%{transform:translateY(-4px) rotate(-.3deg)}}
@keyframes subtleZoom{0%{transform:scale(1)}100%{transform:scale(1.04)}}
@keyframes shimmer{0%,100%{transform:translateY(0);opacity:.6}50%{transform:translateY(-8px);opacity:1}}
@keyframes badgeFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
@keyframes ctaPulse{0%,100%{box-shadow:0 4px 18px rgba(184,92,42,.25)}50%{box-shadow:0 6px 30px rgba(184,92,42,.45)}}
@keyframes pillUp{from{opacity:0;transform:translateX(-50%) translateY(12px)}to{opacity:1;transform:translateX(-50%) translateY(0)}}
@keyframes floatY{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}

/* ── RESPONSIVE ── */
@media(max-width:860px){
  .hero-inner{grid-template-columns:1fr;gap:32px;text-align:center;}
  .hero-sub{margin:0 auto 24px;}
  .hero-actions{justify-content:center;}
  .hero-trust{justify-content:center;}
  .hero-right{max-width:340px;margin:0 auto;}
  /* Keep badges inside scene on tablet */
  .fb-keto{top:5%;right:4%;}
  .fb-smoke{bottom:16%;left:4%;}
  .fb-fresh{display:none;}
  .nav-links{display:none;}
  .hamburger{display:flex;}
  .footer-grid{grid-template-columns:1fr 1fr;}
  .sub-mini{grid-template-columns:1fr 1fr;}
  .steps{grid-template-columns:1fr;}
  .feat{border-right:none;border-bottom:1px solid var(--border);}
  .feat:last-child{border-bottom:none;}
  .sub-hero{flex-direction:column;}
  /* Modal full-screen on tablet */
  .modal-bd{padding:0;align-items:flex-end;}
  .modal-box{border-radius:24px 24px 0 0;max-height:92dvh;overflow-y:auto;}
}
@media(max-width:540px){
  .footer-grid{grid-template-columns:1fr;}
  .meal-body{padding:16px 16px 20px;}
  .macro-grid{grid-template-columns:repeat(2,1fr);}
  .sub-feat-list{grid-template-columns:1fr;}
  .fg-row{grid-template-columns:1fr;}
  .sub-box{padding:24px 22px 26px;}
  /* Hero scene — shrink scene and tuck badges fully inside */
  .hero-right{max-width:290px;}
  .scene{overflow:visible;}
  .fbadge{font-size:.62rem;padding:5px 10px;gap:4px;}
  .fb-keto{top:4%;right:3%;}
  .fb-smoke{bottom:14%;left:3%;}
  .macro-pill{font-size:.68rem;padding:7px 12px;bottom:-10px;}
  .mp-item{padding:0 8px;}
  /* Modals — bottom sheet on mobile */
  .modal-bd{padding:0;align-items:flex-end;}
  .modal-box{border-radius:20px 20px 0 0;max-height:90dvh;overflow-y:auto;-webkit-overflow-scrolling:touch;}
  .cart-box,.auth-box,.sub-box,.survey-box,.meal-box{width:100%;max-width:100%;}
  /* Cart bar above bottom sheet */
  .cart-bar{z-index:600;}
  /* Nav padding mobile */
  nav{padding:11px 4%;}
  /* Menu sticky bar scroll fix */
  .menu-sticky-bar{top:56px;}
}



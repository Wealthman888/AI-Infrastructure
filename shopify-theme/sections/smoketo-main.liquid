  CUR=m;OV_QTY=1;OV_VAR=0;
  document.getElementById('ov-img').innerHTML=`
    <img src="${m.img}" alt="${m.name}" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" style="width:100%;height:100%;object-fit:cover"/>

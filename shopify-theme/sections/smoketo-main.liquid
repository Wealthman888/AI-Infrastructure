      <div class="mc-body">
        <div class="mc-chef">
          <div class="mc-chef-av">${(m.chef||'Chef').split(' ').map(w=>w[0]).join('').slice(0,2)}</div>
          <span class="mc-chef-name">${m.chef||'House Kitchen'}</span>
        </div>
        <div class="mc-name">${m.name}</div>
        <div class="mc-stars">
          <span class="mc-star-row">${starRow(m.stars||4.8)}</span>
          <span class="mc-rating">${(m.stars||4.8).toFixed(1)} (${m.rc||100})</span>
        </div>
        <div class="mc-tags">${(m.dtags||[]).slice(0,3).map(t=>{
          const cls=t.toLowerCase().includes('keto')?'mc-tag-keto':t.toLowerCase().includes('gluten')?'mc-tag-gf':t.toLowerCase().includes('protein')?'mc-tag-hp':'';
          return `<span class="mc-tag ${cls}">${t}</span>`;
        }).join('')}</div>
        <div class="mc-macros">
          <div class="mc-macro"><span class="mc-mv">${m.cal}</span><span class="mc-ml">kcal</span></div>
          <div class="mc-macro"><span class="mc-mv">${m.prot}</span><span class="mc-ml">protein</span></div>
          <div class="mc-macro"><span class="mc-mv">${m.fat}</span><span class="mc-ml">fat</span></div>
          <div class="mc-macro"><span class="mc-mv">${m.carbs}</span><span class="mc-ml">carbs</span></div>
        </div>
        <div class="mc-footer">
          <button class="mc-add-btn" onclick="event.stopPropagation();openMeal(${m.id})">View Meal →</button>
        </div>
      </div>
    </div>
  `).join('');
  setTimeout(activateReveal,40);
}
function filterMenu(el,f){
  document.querySelectorAll('.ftab').forEach(t=>t.classList.remove('on'));
  el.classList.add('on');renderMenu(f);
}
function toggleDiet(el,tag){
  el.classList.toggle('on');
  if(_activeDiet.includes(tag)){_activeDiet=_activeDiet.filter(d=>d!==tag);}else{_activeDiet.push(tag);}
  const active=document.querySelector('.ftab.on');
  const curFilter=active?active.getAttribute('onclick').match(/filterMenu\(this,'(.+?)'\)/)?.[1]||'all':'all';
  renderMenu(curFilter);
}


{%- comment -%}
  Signed-in skip logic: bypass Steps 1-2 (zip/email gate + plan picker) for
  known customers and route straight to their meal-selection dashboard.
  Delivery fee product looked up live — never hardcode its price.
{%- endcomment -%}
{%- assign sk_is_customer = false -%}
{%- if customer -%}{%- assign sk_is_customer = true -%}{%- endif -%}
{%- assign delivery_fee_product = all_products['delivery-fee'] -%}
{%- comment -%}
  Homepage menu — live-looped from the box-meals collection (breakfast/add-on
  items excluded; those live on the Step 4 upsell page only). ID, handle,
  description, image, tags, variants, and macros all come straight from
  Shopify — never hardcoded. Price, chef name, star rating, and badge have no
  Shopify equivalent (box-meal variants are priced $0 for the subscription
  flow, not real a-la-carte retail prices), so those are merged in from the
  MENU_META table below, keyed by product handle.
{%- endcomment -%}
{%- assign sk_menu_meals = collections['box-meals'].products -%}

<script>

// ══════════════════════════════════════════
// REAL SHOPIFY PRODUCT DATA
// ══════════════════════════════════════════
// Always match the current page's actual origin (not a hardcoded domain) —
// the store's primary domain is www.smoketostore.com, and a hardcoded
// non-www value here made every cart fetch cross-origin and silently
// blocked by the browser ("Failed to fetch") whenever a customer landed
// on the canonical www host.
const DOMAIN = window.location.host;
const SK_IS_CUSTOMER = {{ sk_is_customer }};
const SK_DELIVERY_FEE_VARIANT = 55016006680881; // the one allowed hardcode — delivery-fee product's variant ID
const SK_DELIVERY_FEE_PRICE = {{ delivery_fee_product.price | divided_by: 100.0 | round: 2 }};
const SK_MENU_RAW = [
  {%- assign sk_mp = 0 -%}
  {%- for meal in sk_menu_meals -%}
  {%- unless meal.tags contains 'breakfast' or meal.tags contains 'add-on' or meal.tags contains 'one-time' or meal.tags contains 'upsell' -%}
  {% if sk_mp > 0 %},{% endif %}
  {
    id: {{ meal.id }},
    handle: {{ meal.handle | json }},
    name: {{ meal.title | json }},
    full: {{ meal.description | strip_html | json }},
    tags: {{ meal.tags | json }},
    img: {% if meal.featured_image %}{{ meal.featured_image | image_url: width: 800 | json }}{% else %}null{% endif %},
    prot: {{ meal.metafields.nutrition.protein | default: '' | json }},
    fat: {{ meal.metafields.nutrition.fat | default: '' | json }},
    carbs: {{ meal.metafields.nutrition.netcarbs | default: meal.metafields.nutrition.totalcarb | default: '' | json }},
    variants: [
      {%- for v in meal.variants -%}
      { id: {{ v.id }}, t: {{ v.title | json }}, sp: {{ v.price | divided_by: 100.0 | round: 2 }} }
      {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  {%- assign sk_mp = sk_mp | plus: 1 -%}
  {%- endunless -%}
  {%- endfor -%}
];

// Marketing data with no Shopify equivalent — keyed by product handle. Price
// here is the a-la-carte menu price (distinct from the $0 box-selection
// variant price used by the subscription flow). Add an entry whenever a new
// meal joins the box-meals collection; unlisted meals fall back to
// MENU_META_DEFAULT so the menu never breaks.
const MENU_META = {
  'shepherds-pie': {chef:'Chef Amara',stars:4.9,rc:189,bt:'popular',bl:'Popular',price:14.99,cal:'326',dtags:['Keto','Gluten-Free','Comfort Food']},
  'chipotle-chicken-taco-bowl': {chef:'Chef Diego',stars:4.7,rc:241,bt:'keto',bl:'Keto',price:13.99,cal:'298',dtags:['Keto','Gluten-Free','Bowls']},
  'shrimp-scampi-with-spaghetti-squash': {chef:'Chef Sofia',stars:4.9,rc:156,bt:'new',bl:'New',price:16.99,cal:'302',dtags:['Keto','Gluten-Free','Seafood']},
  'in-n-out-style-wagyu-burger-bowl': {chef:'Chef Marcus',stars:4.9,rc:298,bt:'popular',bl:'Popular',price:14.99,cal:'390',dtags:['Keto','Gluten-Free','Premium Wagyu']},
  'smoked-chicken-with-broccoli': {chef:'Chef Marcus',stars:4.8,rc:207,bt:'keto',bl:'Keto',cal:'306',dtags:['Keto','Gluten-Free','High Protein'],
    variantPrices:{'4oz':12.99,'Double Protein':17.99}},
  'pork-tenderloin-with-broccoli': {chef:'Chef Diego',stars:4.6,rc:174,bt:'keto',bl:'Keto',cal:'274',dtags:['Keto','Gluten-Free','High Protein'],
    variantPrices:{'4oz':12.99,'Double Protein':17.99}},
  'keto-street-tacos': {chef:'Chef Diego',stars:4.9,rc:332,bt:'popular',bl:'Popular',cal:'334',dtags:['Keto','Gluten-Free','Customizable'],
    variantPrices:{
      'Chicken / Cheese Please!':14.99,'Chicken / No Cheese':14.99,
      'Pulled Pork / Cheese Please!':14.99,'Pulled Pork / No Cheese':14.99,
      'Shrimp / Cheese Please!':16.99,'Shrimp / No Cheese':16.99,
      'Brisket / Cheese Please!':17.99,'Brisket / No Cheese':17.99
    }},
  'chicken-teriyaki-bowl': {chef:'Chef Sofia',stars:4.8,rc:120,bt:'new',bl:'New',price:14.99,cal:'354',dtags:['Keto','Bowls']},
  'peanut-chicken-coconut-curry': {chef:'Chef Amara',stars:4.8,rc:98,bt:'new',bl:'New',price:15.99,cal:'610',dtags:['Keto','High Protein']},
  'smoked-tri-tip-with-chimichurri': {chef:'Chef Marcus',stars:4.9,rc:145,bt:'new',bl:'New',price:17.99,cal:'400',dtags:['Keto','Gluten-Free','Premium Cut']}
};
const MENU_META_DEFAULT = {chef:'House Kitchen',stars:4.8,rc:100,bt:'keto',bl:'Keto',price:14.99,cal:'—',dtags:['Keto']};

function skCategoryFromTags(tags){
  const t=(tags||[]).join(',').toLowerCase();
  if(t.includes('seafood')||t.includes('shellfish'))return 'seafood';
  if(t.includes('bowls')||t.includes('bowl'))return 'bowls';
  return 'keto';
}
const PRODUCTS = SK_MENU_RAW.map(function(raw){
  const meta=MENU_META[raw.handle]||MENU_META_DEFAULT;
  const vars=raw.variants.map(function(v){
    const p=(meta.variantPrices&&meta.variantPrices[v.t]!=null)?meta.variantPrices[v.t]:(meta.price!=null?meta.price:MENU_META_DEFAULT.price);
    // p = marketing/display price shown on meal cards. sp = the real Shopify
    // variant price — $0 for standard box meals, >0 only for priced upgrades
    // (e.g. "Double Protein") — used for checkout math, never for display.
    return {id:v.id,t:v.t,p:p,sp:v.sp};
  });
  const prot=raw.prot||MENU_META_DEFAULT.prot||'';
  const dietTags=raw.tags.filter(function(t){return t==='keto'||t==='gluten-free';});
  if(parseInt(prot)>=35)dietTags.push('high-protein');
  const shortDesc=raw.full.length>140?raw.full.slice(0,137)+'...':raw.full;
  return {
    id:raw.id,cat:skCategoryFromTags(raw.tags),chef:meta.chef,stars:meta.stars,rc:meta.rc,
    dietTags:dietTags,name:raw.name,short:shortDesc,full:raw.full,tags:raw.tags,img:raw.img,vars:vars,
    cal:meta.cal,prot:prot,fat:raw.fat||'',carbs:raw.carbs||'',
    dtags:meta.dtags,bt:meta.bt,bl:meta.bl
  };
});

{%- comment -%}
  Box-tier products, looked up by their fixed handle (each is a single-variant
  product). Weekly price, per-meal price, and savings % are all computed from
  the live product price — repricing in Shopify Admin needs zero code changes.
{%- endcomment -%}
{%- assign plan5  = all_products['smoketo-weekly-box-5-meals'] -%}
{%- assign plan8  = all_products['smoketo-weekly-box-8-meals'] -%}
{%- assign plan13 = all_products['smoketo-weekly-box-13-meals'] -%}
{%- assign plan21 = all_products['smoketo-weekly-box-21-meals'] -%}
{%- assign pmc5  = plan5.price  | divided_by: 5.0  | round -%}
{%- assign pmc8  = plan8.price  | divided_by: 8.0  | round -%}
{%- assign pmc13 = plan13.price | divided_by: 13.0 | round -%}
{%- assign pmc21 = plan21.price | divided_by: 21.0 | round -%}
{%- assign r13 = pmc13 | times: 1.0 | divided_by: pmc5 -%}
{%- assign save13 = 1.0 | minus: r13 | times: 100 | round -%}
{%- assign r21 = pmc21 | times: 1.0 | divided_by: pmc5 -%}
{%- assign save21 = 1.0 | minus: r21 | times: 100 | round -%}
const SUB_PLANS = [
  {meals:5,  weekly:{{ plan5.price  | divided_by: 100.0 | round: 2 }}, price:{{ pmc5  | divided_by: 100.0 | round: 2 }}, save:0, label:'Starter', box:{{ plan5.selected_or_first_available_variant.id }}},
  {meals:8,  weekly:{{ plan8.price  | divided_by: 100.0 | round: 2 }}, price:{{ pmc8  | divided_by: 100.0 | round: 2 }}, save:0, label:'Popular', badge:'Most Popular', box:{{ plan8.selected_or_first_available_variant.id }}},
  {meals:13, weekly:{{ plan13.price | divided_by: 100.0 | round: 2 }}, price:{{ pmc13 | divided_by: 100.0 | round: 2 }}, save:{{ save13 }}, label:'Growth',  badge:'Best Value', box:{{ plan13.selected_or_first_available_variant.id }}},
  {meals:21, weekly:{{ plan21.price | divided_by: 100.0 | round: 2 }}, price:{{ pmc21 | divided_by: 100.0 | round: 2 }}, save:{{ save21 }}, label:'Elite', box:{{ plan21.selected_or_first_available_variant.id }}}
];
let selPlan = 1;

const REVIEWS = [
  {av:'👩',name:'Kira M.',loc:'Summerlin, NV',s:5,txt:"Honestly the best meal prep in Las Vegas. The brisket is ridiculous — my husband stopped asking me to cook dinner 😂"},
  {av:'💪',name:'Marcus D.',loc:'Henderson, NV',s:5,txt:"Lost 18 lbs in 2 months eating meals that taste like they're from a restaurant. SmoKeto is the move."},
  {av:'🏃',name:'Tanya R.',loc:'Spring Valley, NV',s:5,txt:"The breakfast scramble is my every-morning staple. Quick, filling, macro-perfect for my keto goals."},
  {av:'👨',name:'Carlos V.',loc:'North Las Vegas, NV',s:5,txt:"Skip the food prep, skip the counting. Fresh every week, always on time. 10/10."},
  {av:'👩‍⚕️',name:'Dr. Priya S.',loc:'Downtown LV',s:5,txt:"As a physician I'm picky about nutrition labels. SmoKeto is legit — clean ingredients, real macros."},
  {av:'🎰',name:'Jake T.',loc:'Paradise, NV',s:5,txt:"I work nights on the Strip. Having meals ready to heat at 4am has been a game changer."},
  {av:'🤰',name:'Alicia P.',loc:'Centennial Hills, NV',s:5,txt:"GF approved and actually delicious. The cheesy egg bites are perfection every morning!"},
  {av:'🏋️',name:'DeShawn B.',loc:'Enterprise, NV',s:5,txt:"My trainer recommended SmoKeto. The Wagyu Burger Bowl is elite — never going back."},
];

// ── ZIP CHECK ──
const ZIPS=new Set([89002,89009,89011,89012,89014,89015,89016,89019,89025,89030,89031,89032,89033,89044,89052,89053,89074,89077,89086,89087,89101,89102,89103,89104,89106,89107,89108,89109,89110,89111,89112,89113,89114,89115,89117,89118,89119,89120,89121,89122,89123,89124,89128,89129,89130,89131,89134,89135,89138,89139,89141,89142,89143,89144,89145,89146,89147,89148,89149,89156,89166,89178,89179,89183]);

function dismissGate(){
  const g=document.getElementById('gate');
  g.style.transition='opacity .5s';g.style.opacity='0';
  setTimeout(()=>{g.style.display='none';},500);
}

// ── KLAVIYO (Step 1 capture) ──
// TODO: replace these placeholders with real Klaviyo credentials before launch.
const KLAVIYO_COMPANY_ID='REPLACE_WITH_KLAVIYO_COMPANY_ID';
const KLAVIYO_PUBLIC_API_KEY='REPLACE_WITH_KLAVIYO_PUBLIC_API_KEY';
const KLAVIYO_LIST_ID='REPLACE_WITH_KLAVIYO_LIST_ID';
function pushToKlaviyo(email,zip){
  try{
    if(typeof klaviyo!=='undefined'){
      klaviyo.identify({'$email':email,'delivery_zip':zip});
    }
  }catch(e){}
  try{
    fetch(`https://a.klaviyo.com/api/v2/list/${KLAVIYO_LIST_ID}/subscribe?api_key=${KLAVIYO_PUBLIC_API_KEY}`,{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({profiles:[{email,delivery_zip:zip}]})
    }).catch(()=>{});
  }catch(e){}
}

function checkZip(){
  const z=document.getElementById('zip-in').value.trim();
  const email=document.getElementById('gate-email').value.trim();
  const err=document.getElementById('gate-err');
  if(!/^\d{5}$/.test(z)){err.style.display='block';err.textContent='⚠ Please enter a valid 5-digit ZIP code.';return;}
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){err.style.display='block';err.textContent='⚠ Please enter a valid email address.';return;}
  if(ZIPS.has(parseInt(z))){
    try{
      localStorage.setItem('sk_zip',z);
      sessionStorage.setItem('sk_session_zip',z);
      sessionStorage.setItem('sk_session_email',email);
    }catch(e){}
    pushToKlaviyo(email,z);
    // Return to the homepage as-is — no interstitial. Plan selection (Step 2) is
    // reached only when the customer taps a tier card, not automatically here.
    dismissGate();
  }else{
    err.style.display='block';
    err.textContent="⚠ We don't deliver there yet. We currently serve Southern Nevada (89xxx ZIPs).";
  }
}
document.getElementById('zip-in').addEventListener('keydown',e=>{if(e.key==='Enter')checkZip();});
document.getElementById('gate-email').addEventListener('keydown',e=>{if(e.key==='Enter')checkZip();});

// Signed-in customers skip Steps 1-2 entirely — no zip/email gate, no plan modal.
